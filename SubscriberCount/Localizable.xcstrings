          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Менің сұрағым мұнда тізімде жоқ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minha pergunta não está listada aqui."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "என் கேள்வி இங்கே பட்டியலிடப்படவில்லை."
          }
        },
        "tr" : {
          "stringUnit" : {

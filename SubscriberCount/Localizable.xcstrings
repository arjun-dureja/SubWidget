            "value" : "اسحب إلى اليمين على القناة لحذفها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wischen Sie auf dem Kanal nach rechts, um ihn zu löschen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia la derecha sobre el canal para eliminarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la chaîne vers la droite pour la supprimer"
          }

            "value" : "Ajoutez une chaîne dans l’app"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप में एक चैनल जोड़ें"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um canal no app"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "செயலியில் ஒரு சேனலைச் சேர்க்கவும்"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

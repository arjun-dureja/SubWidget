          }
        }
      }
    },
    "This indicates a server issue. Please try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يشير إلى مشكلة في الخادم. يرجى المحاولة مرة أخرى لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies deutet auf ein Serverproblem hin. Bitte versuchen Sie es später noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto indica un problema con el servidor. Por favor, inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela indique un problème de serveur. Veuillez réessayer plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक सर्वर समस्या को दर्शाता है। कृपया बाद में पुनः प्रयास करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso indica um problema no servidor. Por favor, tente novamente mais tarde."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது ஒரு சேவையக சிக்கலை குறிக்கிறது. தயவுசெய்து பின்னர் முயற்சிக்கவும்."
          }
        }
      }
    },

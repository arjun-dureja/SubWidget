            "value": "சப்விஜெட்டில் புதியது என்ன?"
          }
        }
      }
    },
    "Why doesn't it show the exact subscriber count?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا لا يظهر عدد المشتركين الدقيق؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum zeigt es nicht die genaue Abonnentenzahl an?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué no muestra el conteo exacto de suscriptores?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi cela n'affiche-t-il pas le nombre exact d'abonnés ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सटीक सब्सक्राइबर गिनती क्यों नहीं दिखाता है?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que não mostra a contagem exata de inscritos?"
          }
        },
        "ta": {

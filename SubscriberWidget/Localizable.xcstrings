    "Restores the widget's colors to the defaults - White in light mode and black in dark mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد ألوان الأداة إلى الإعدادات الافتراضية: الأبيض في الوضع الفاتح والأسود في الوضع الداكن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt die Widget-Farben auf die Standardwerte zurück: Weiß im hellen Modus und Schwarz im dunklen Modus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablece los colores del widget a los predeterminados: blanco en modo claro y negro en modo oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaure les couleurs du widget par défaut : blanc en mode clair et noir en mode sombre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विजेट के रंग डिफ़ॉल्ट पर वापस कर देता है - लाइट मोड में सफेद और डार्क मोड में काला।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengembalikan warna widget ke default - Putih dalam mode terang dan hitam dalam mode gelap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットの色をデフォルト (ライト モードでは白、ダーク モードでは黒) に戻します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виджет түстерін әдепкі мәндерге қалпына келтіреді - жарық режимінде ақ және қараңғы режимде қара."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura as cores do widget para o padrão: branco no modo claro e preto no modo escuro."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விட்ஜெட்டின் நிறங்களை இயல்புநிலைக்கு மீட்டமைக்கும் - ஒளி முறையில் வெள்ளை, இருள் முறையில் கருப்பு."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget'ın renklerini varsayılan ayarlara geri yükler - Açık modda beyaz ve karanlık modda siyah."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将小组件的颜色恢复为默认值 - 浅色模式下为白色，深色模式下为黑色。"
          }
        }
      }
    },

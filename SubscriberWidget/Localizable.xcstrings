{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "- Add a channel in the app, then tap this widget while editing" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- أضف قناة في التطبيق، ثم اضغط على هذه الأداة أثناء تعديلها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Fügen Sie zuerst in der App einen Kanal hinzu und tippen Sie dann beim Bearbeiten auf dieses Widget"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Agrega un canal en la app y luego toca este widget mientras lo editas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Ajoutez d’abord une chaîne dans l’app, puis touchez ce widget pendant sa modification"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- पहले ऐप में एक चैनल जोड़ें, फिर एडिट करते समय इस विजेट पर टैप करें"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Adicione um canal no app e depois toque neste widget enquanto o estiver editando"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- முதலில் செயலியில் ஒரு சேனலைச் சேர்க்கவும், பின்னர் திருத்தும் போது இந்த விட்ஜெட்டைத் தட்டவும்"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- アプリにチャンネルを追加し、編集中にこのウィジェットをタップします"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- 在应用程序中添加频道，然后在编辑时点击此小组件"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Қолданбаға арна қосыңыз, содан кейін өңдеу кезінде осы виджетті түртіңіз"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Tambahkan saluran di aplikasi, lalu ketuk widget ini saat mengedit"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Uygulamaya bir kanal ekleyin ve ardından düzenleme yaparken bu widget'a dokunun"
          }
        }
      }
    },

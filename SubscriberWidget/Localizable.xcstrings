            "state": "translated",
            "value": "ஏன் அது குறிப்பிட்ட சந்தாதாரர் எண்ணிக்கையை காட்டவில்லை?"
          }
        }
      }
    },
    "Wishlist": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة الرغبات"
          }
        },
        "de": {

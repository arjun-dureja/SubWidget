    "%@ reached %@ subscribers!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل %1$@ إلى %2$@ مشترك!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat %2$@ Abonnenten erreicht!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ reached %2$@ subscribers!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡%1$@ alcanzó %2$@ suscriptores!"

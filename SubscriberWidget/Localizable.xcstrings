          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, instale um aplicativo de e-mail para continuar"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடர ஒரு மின்னஞ்சல் செயலியை நிறுவவும்"
          }
        },
        "tr" : {

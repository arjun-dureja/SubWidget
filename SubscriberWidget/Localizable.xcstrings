    "Search a channel. Add the widget." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث عن قناة. ثم أضف الأداة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchen Sie einen Kanal. Fügen Sie das Widget hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca un canal. Agrega el widget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez une chaîne. Ajoutez le widget."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक चैनल खोजें। विजेट जोड़ें।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {

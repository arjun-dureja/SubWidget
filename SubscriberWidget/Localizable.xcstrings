    "Search by name, @handle, or channel ID. See a preview instantly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث بالاسم أو @المعرّف أو رقم القناة. شاهد المعاينة فورًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchen Sie nach Name, @Handle oder Kanal-ID. Sehen Sie sofort eine Vorschau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca por nombre, @usuario o ID del canal. Mira la vista previa al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez par nom, @identifiant ou ID de chaîne. Voyez l’aperçu instantanément."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाम, @हैंडल या चैनल आईडी से खोजें। तुरंत प्रीव्यू देखें।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquise por nome, @perfil ou ID do canal. Veja a prévia na hora."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பெயர், @handle அல்லது சேனல் ஐடி மூலம் தேடுங்கள். முன்னோட்டத்தை உடனே பாருங்கள்."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前、@handle、またはチャンネルIDで検索。すぐにプレビューを表示できます。"
          }
        },
        "zh-Hans" : {

        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ жазылушыға жетті!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ alcançou %2$@ inscritos!"

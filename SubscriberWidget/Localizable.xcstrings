    "View both your subscriber and view counts in one widget": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض عدد المشتركين والمشاهدات في أداة واحدة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir sowohl deine Abonnenten- als auch Aufrufzahlen in einem Widget an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta tanto tus suscriptores como tus visualizaciones en un solo widget"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez à la fois votre nombre d’abonnés et de vues dans un seul widget"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही विजेट में अपने सब्सक्राइबर और व्यू की संख्या देखें"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o número de inscritos e visualizações em um único widget"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே விட்ஜெட்டில் உங்கள் சந்தாதாரர்கள் மற்றும் பார்வைகள் எண்ணிக்கையை காணுங்கள்"
          }
        }
      }
    },
    "What does the reset button do?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا يفعل زر إعادة الضبط؟"
          }
